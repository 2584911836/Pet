static func key(index: int) -> String:
	return "survey_%d" % index
static func count(flags: Dictionary, zone: int = -1) -> int:
	var result := 0
	for i in range(9):
		if (zone < 0 or int(i/3) == zone) and flags.get(key(i),false): result += 1
	return result
