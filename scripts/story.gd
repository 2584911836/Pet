const KEEPER_TOPICS = {
	"research":{"title":"父母为什么失联？", "text":"阿岚：你父母发现，有人把野外伙伴当成货物转移。他们拒绝交出真实的栖息记录，因此被困在研究站。\n\n洛汐：登记更多伙伴，就能找到证据？\n\n阿岚：是的。但不需要抓满所有伙伴才能救人。每完成一地资格，我们就能核对下一段运输记录。"},
