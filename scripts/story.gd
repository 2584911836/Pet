static func objective(game) -> Dictionary:
	if game.story_flags.get("champion",false):
		return {"title":"尾声 · 图鉴仍有下一页", "step":"主线完成 · 完成地区调查或收集全部伙伴", "goal":"camp", "progress":"图鉴 %d / 108" % game.discovered(),"zone":game.zone,"area":game.area}
	if game.story_flags.get("parents_rescued",false):
		return {"title":"终章 · 冠军挑战", "step":"返回星原联赛中心，前往东北赛场挑战许澈", "goal":"arena", "progress":"父母已获救 · 冠军赛待完成","zone":2,"area":0}
	if game.completed.count(true) == 3:
		return {"title":"第四章 · 研究站救援", "step":"前往研究站外围，进入东北入口击败封锁员", "goal":"arena", "progress":"三地资格齐全 · 父母等待救援","zone":2,"area":2}
	if game.completed[game.zone]:
		var destination := 1 if not game.completed[1] else 2
		return {"title":CHAPTERS[game.zone].title, "step":"沿驿道前往下一地区，继续调查与资格赛", "goal":"camp", "progress":"地区徽章 %d / 3" % game.completed.count(true),"zone":destination,"area":0}
	if game.fragments < 3:
		return {"title":CHAPTERS[game.zone].title, "step":"赢得遭遇战或捕捉伙伴，取得 3 资格积分", "goal":"grass", "progress":"资格积分 %d / 3" % game.fragments,"zone":game.zone,"area":game.area}
	return {"title":CHAPTERS[game.zone].title, "step":"前往东北赛场，完成本地区导师挑战", "goal":"arena", "progress":"资格积分 3 / 3 · 导师待挑战","zone":game.zone,"area":0}
